# Public app origin used for metadata and OAuth callback redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Auth + Postgres persistence (optional; demo mode remains local when unset).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key required for permanent account deletion. Never expose it publicly.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only key required for permanent account deletion. Never expose it publicly.
SUPABASE_SERVICE_ROLE_KEY=

# Required to encrypt short-lived OAuth state and provider access-token cookies.
# Use a random value of at least 32 characters in each deployment.
PROVIDER_SESSION_SECRET=replace-with-a-random-32-character-secret

# Spotify OAuth / Web API
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/provider/spotify/callback
# Optional local-only server token; prefer OAuth cookies in production.
SPOTIFY_ACCESS_TOKEN=

# YouTube OAuth / Data API v3
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/provider/youtube/callback
YOUTUBE_DATA_API_KEY=
# Optional local-only server token; prefer OAuth cookies in production.
YOUTUBE_ACCESS_TOKEN=

# Optional AI narration; deterministic scoring works without it.
GEMINI_API_KEY=
