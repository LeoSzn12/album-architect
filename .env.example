# ============================================================================
# Album Architect — Environment Variables
# Copy this file to `.env.local` and fill in your values.
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase (auth, sessions, leaderboard, provider accounts)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Provider OAuth — Spotify
# Create an app at https://developer.spotify.com/dashboard
#   - Redirect URI (local):  http://localhost:3000/api/auth/provider/spotify/callback
#   - Redirect URI (prod):   https://<your-app>.workers.dev/api/auth/provider/spotify/callback
#   - Scopes requested by the app: playlist-read-private, playlist-modify-public,
#     playlist-modify-private, user-read-private, streaming, user-read-email
#   - `streaming` + `user-read-email` enable the Web Playback SDK (full-track
#     in-browser playback for Premium users).
# ---------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/provider/spotify/callback

# ---------------------------------------------------------------------------
# Provider OAuth — YouTube
# Create OAuth credentials at https://console.cloud.google.com
#   - Enable the YouTube Data API v3
#   - OAuth consent screen → External → add your email as a test user
#   - OAuth client ID (Web application):
#       Redirect URI (local): http://localhost:3000/api/auth/provider/youtube/callback
#       Redirect URI (prod):  https://<your-app>.workers.dev/api/auth/provider/youtube/callback
#   - Also create an API key (used by the catalog ID resolution script — no
#     user login required).
# ---------------------------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/provider/youtube/callback
YOUTUBE_DATA_API_KEY=

# ---------------------------------------------------------------------------
# Provider session encryption
# Encrypts OAuth state + provider access tokens in httpOnly cookies.
# MUST be at least 32 characters. Generate with: openssl rand -base64 48
# ---------------------------------------------------------------------------
PROVIDER_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Site URL (used for OAuth redirect targets)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional: server-side provider tokens (bypass OAuth for search/import/export)
# These are only needed if you want the server to act as a fixed provider
# account without per-user OAuth. Normally you can leave these empty and rely
# on the OAuth flow above.
# ---------------------------------------------------------------------------
# SPOTIFY_ACCESS_TOKEN=
# YOUTUBE_ACCESS_TOKEN=
